# Canonical Real Business Cycle (RBC) Model
# Written for Dyno (https://github.com/EconForge/dyno.py)

# ---------------------------------------------------------------------------
# 1. Calibration / Parameters
# ---------------------------------------------------------------------------
beta  <- 0.985   # Discount factor
delta <- 0.025   # Depreciation rate (quarterly, 2.5%)
nss   <- 0.33    # Steady-state labor hours (approx 1/3 of time endowment)
eta   <- 1.0      # Frisch elasticity parameter
alpha <- 0.32    # Capital share in production
rho   <- 0.90    # TFP persistence
chi   <- (1-alpha)*(1-nss)^eta/nss*(1/beta-1+delta)/(1/beta-1+delta-delta*alpha)

# ---------------------------------------------------------------------------
# 2. Steady State Values
# ---------------------------------------------------------------------------
a[~] <- 1.0
r[~] <- 1/beta - 1 + delta
n[~] <- nss
k[~] <- (alpha / r[~])^(1/(1-alpha)) * n[~]
y[~] <- k[~]^alpha * n[~]^(1-alpha)
w[~] <- (1-alpha) * y[~] / n[~]
i[~] <- delta * k[~]
c[~] <- y[~] - i[~]

# ---------------------------------------------------------------------------
# 3. Dynamic Equations
# ---------------------------------------------------------------------------
# Euler equation
1/c[t] = beta * (r[t+1] + 1 - delta) / c[t+1]

# Labor supply / Intratemporal condition
w[t] = chi * c[t] / (1 - n[t])^eta

# Capital accumulation
k[t] = (1 - delta) * k[t-1] + i[t]

# Production function (Cobb-Douglas)
y[t] = a[t] * k[t-1]^alpha * n[t]^(1-alpha)

# Total factor productivity shock process (AR(1))
log(a[t]) = rho * log(a[t-1]) + epsilon[t]

# Factor prices (competitive markets)
w[t] = (1 - alpha) * y[t] / n[t]
r[t] = alpha * y[t] / k[t-1]

# Resource constraint / Goods market clearing
y[t] = c[t] + i[t]

# ---------------------------------------------------------------------------
# 4. Exogenous Processes / Shocks
# ---------------------------------------------------------------------------
epsilon[t] <- N(0, 0.009^2)

# Optional run directives for automated pipelines
@run: check
@run: solve
