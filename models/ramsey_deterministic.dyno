# Neoclassical Ramsey Model with Perfect Foresight / Deterministic Transition
# Written for Dyno (https://github.com/EconForge/dyno.py)

# ---------------------------------------------------------------------------
# 1. Parameters
# ---------------------------------------------------------------------------
alph <- 0.50     # Capital share
gam  <- 0.50     # Relative risk aversion
delt <- 0.02     # Depreciation rate
bet  <- 0.051    # Discount rate (quarterly)
aa   <- 0.511    # Productivity scaling factor
T    <- 50       # Simulation time horizon

# ---------------------------------------------------------------------------
# 2. Steady State
# ---------------------------------------------------------------------------
x[~] <- 1.0
k[~] <- ((delt + bet) / (1.0 * aa * alph))^(1 / (alph - 1))
c[~] <- aa * k[~]^alph - delt * k[~]

# ---------------------------------------------------------------------------
# 3. Dynamic Equations
# ---------------------------------------------------------------------------
# Resource constraint: c_t + k_t = aa*x_t*k_{t-1}^alph + (1-delt)*k_{t-1}
0 = c[t] + k[t] - aa*x[t]*k[t-1]^alph - (1 - delt)*k[t-1]

# Euler equation: c_t^(-gam) = (1+bet)^(-1) * (aa*alph*x_{t+1}*k_t^(alph-1) + 1 - delt) * c_{t+1}^(-gam)
0 = c[t]^(-gam) - (1 + bet)^(-1) * (aa*alph*x[t+1]*k[t]^(alph-1) + 1 - delt) * c[t+1]^(-gam)

# ---------------------------------------------------------------------------
# 4. Anticipated Exogenous Trajectory (Productivity shock path)
# ---------------------------------------------------------------------------
# Periods 1 and 2 experience an anticipated temporary boost in TFP:
x[1] <- 1.10
x[2] <- 1.30

# Subsequent decay back towards steady-state productivity (x = 1.0):
forall t, 3 <= t < T : x[t] <- 1.0 + (1.30 - 1.0) * exp(-(t - 1))

# Run directive: the same analysis is available from a report or the CLI.

@run: steady
@run: check
@run: simulate
